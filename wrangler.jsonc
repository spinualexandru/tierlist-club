// Cloudflare Worker serving the built SPA from dist/ as static assets (no Worker script).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tierlist-club",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (/harnesses, /models, ...) get index.html, so the client router takes over.
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "tierlist.club", "custom_domain": true }],
  "preview_urls": true,
  "observability": { "enabled": true },
}
