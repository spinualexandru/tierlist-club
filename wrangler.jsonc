// Cloudflare Worker serving the built SPA from dist/ as static assets, plus the small
// analytics endpoint in worker/ for /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tierlist-club",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every list has its own prerendered page (/models serves models.html, see the `seo` plugin
    // in vite.config.ts), so any other path is a real 404, with the app's 404 page.
    "not_found_handling": "404-page",
    // Only these paths reach the Worker script; the rest are served straight from dist/. `/` is
    // there for shared links (`/?type=<list id>&…`), which get their list's page.
    "run_worker_first": ["/api/*", "/"],
  },
  "routes": [{ "pattern": "tierlist.club", "custom_domain": true }],
  "preview_urls": true,
  // Custom events (lists started, PNGs exported), written by worker/index.ts. Queried with
  // scripts/events.ts; the dataset is created on the first write.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "tierlist_events" }],
  "observability": { "enabled": true },
}
